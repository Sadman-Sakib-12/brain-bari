# Server Port & Environment
PORT=5000
NODE_ENV=development

# NeonDB PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/botbari_db?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/botbari_db?sslmode=require"

# JWT Authentication
JWT_SECRET="brain-bari_super_secure_enterprise_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Stripe Payment Gateway Secret Key
STRIPE_SECRET_KEY="your_stripe_secret_key_here"

# Allowed CORS Origins
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Nodemailer / SMTP Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"